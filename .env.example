POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=mindtrace_db
VITE_API_BASE_URL=http://localhost:8080
JWT_SECRET=run openssl rand -base64 32  
DB_DRIVER=postgres
GO_ENV=dev
SKIP_DB_INIT=false
FRONTEND_ORIGINS=http://localhost:5173

# SMTP: Mailpit embutido no docker-compose (dev e prod/homologação)
# Emails capturados em http://localhost:8025
# Nenhuma configuração necessária - backend aponta para mailpit:1025 automaticamente